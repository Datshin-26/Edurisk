            },
            {
              "name": "workflow_status",
              "value": "eq.intervention_pending"
            },
            {
              "name": "follow_up_due_at",
              "value": "={{ 'lte.' + $now.toISO() }}"
            },
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        },
        "options": {}
      },
      "alwaysOutputData": true,
      "id": "06ac2793-2ebf-4aa6-a735-4759063a4f49",
      "name": "Find due follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 160]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all()\n  .map(({ json }) => Array.isArray(json) ? json : (json && Object.keys(json).length ? [json] : []))\n  .flat()\n  .filter((row) => row.source_prediction_id !== undefined)\n  .map((row) => ({ json: { source_prediction_id: Number(row.source_prediction_id) } }));"
      },
      "id": "6ad1e498-6033-4944-94ef-14377024dd33",
      "name": "Prepare due follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

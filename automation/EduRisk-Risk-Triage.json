        "method": "PATCH",
        "url": "={{ 'https://cfuhfiucikhlzglcleab.supabase.co/rest/v1/risk_interventions?source_prediction_id=eq.' + $json.source_prediction_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"workflow_status\":\"follow_up_due\"}",
        "options": {}
      },
      "id": "d3c7eebd-b409-489b-b6f0-d37c6e04b39f",

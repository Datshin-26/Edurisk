            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "2019013a-bdb2-49ba-adc6-98fe2687e40a",
      "name": "Log medium-low monitoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -80]
    },
    {
      "parameters": {
        "url": "https://cfuhfiucikhlzglcleab.supabase.co/rest/v1/risk_interventions",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",

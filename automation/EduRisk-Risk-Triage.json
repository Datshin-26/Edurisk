          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "0567375c-f353-4b88-96fd-7a19f58bc7d9",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://cfuhfiucikhlzglcleab.supabase.co/rest/v1/risk_predictions",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "prediction_id,student_id,model_version,risk_level,risk_score,predicted_at"
            },
            {
              "name": "order",
              "value": "predicted_at.desc,prediction_id.desc"
            },
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        },
        "options": {}
      },
      "id": "79f8000b-abf4-41a7-a57f-31cabce988df",
      "name": "Fetch risk predictions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, -160]
    },
    {
      "parameters": {
        "url": "https://cfuhfiucikhlzglcleab.supabase.co/rest/v1/risk_interventions",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "source_prediction_id"
            },
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        },
        "options": {}
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "id": "4bb719c9-42bc-46f2-b134-8dd57fc4a678",
      "name": "Fetch processed prediction IDs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, -160]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const asRows = (items) => items.flatMap(({ json }) => Array.isArray(json) ? json : (json && Object.keys(json).length ? [json] : []));\nconst predictions = asRows($(\"Fetch risk predictions\").all());\nconst processedIds = new Set(asRows($input.all()).map((row) => String(row.source_prediction_id)));\nconst latestByStudentAndModel = new Map();\nfor (const prediction of predictions) {\n  const key = `${prediction.student_id}:${prediction.model_version}`;\n  const current = latestByStudentAndModel.get(key);\n  const newer = !current || String(prediction.predicted_at) > String(current.predicted_at) || (prediction.predicted_at === current.predicted_at && Number(prediction.prediction_id) > Number(current.prediction_id));\n  if (newer) latestByStudentAndModel.set(key, prediction);\n}\nconst now = Date.now();\nreturn [...latestByStudentAndModel.values()]\n  .filter((row) => !processedIds.has(String(row.prediction_id)))\n  .map((row) => {\n    const highRisk = row.risk_level === \"High\";\n    return { json: {\n      source_prediction_id: Number(row.prediction_id),\n      student_id: row.student_id,\n      model_version: row.model_version,\n      risk_level: row.risk_level,\n      risk_score: Number(row.risk_score),\n      action_type: highRisk ? \"human_check_in\" : \"monitor\",\n      workflow_status: highRisk ? \"intervention_pending\" : \"monitoring\",\n      notification_status: highRisk ? \"needs_contact_data\" : \"not_required\",\n      follow_up_due_at: highRisk ? new Date(now + 7 * 24 * 60 * 60 * 1000).toISOString() : null\n    } };\n  });"
      },
      "id": "f668b920-a7d8-4491-b1b0-63a9391e7c67",
      "name": "Select latest unprocessed students",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, -160]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f8de5e54-d6c6-4a77-b16d-3bc37620ef1e",
              "leftValue": "={{ $json.risk_level }}",
              "rightValue": "High",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cf2ef76c-683d-44f1-8a7d-0e167e8c218f",
      "name": "High risk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [960, -160]
    },
    {
      "parameters": {

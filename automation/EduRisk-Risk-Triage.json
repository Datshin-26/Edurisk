              "name": "Prefer",
              "value": "resolution=ignore-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "58c3ecf3-a4d0-438c-8656-2b1ed9bed8cd",
      "name": "Queue high-risk intervention",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
